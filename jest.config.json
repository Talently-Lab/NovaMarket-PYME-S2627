{
  "testEnvironment": "node",
  "roots": [
    "<rootDir>/tests/api",
    "<rootDir>/tests/unit",
    "<rootDir>/tests/security"
  ],
  "transform": {
    "^.+\\.tsx?$": "ts-jest"
  },
  "testMatch": [
    "**/*.test.ts",
    "**/*.spec.ts"
  ],
  "moduleDirectories": ["node_modules", "backend/node_modules"],
  "collectCoverageFrom": [
    "backend/src/**/*.js",
    "!backend/src/index.js"
  ],
  "coverageThreshold": {
    "global": {
      "lines": 30
    }
  },
  "_coverageThresholdNote": "Umbral reducido a 30% para el estado actual (72 tests, sin tests de integración reales). Aumentar a 80% cuando se implementen tests de integración con DB (Sprint 2-3). Ver docs/TEST_PLAN.md sección 4.",
  "coverageReporters": ["html", "lcov", "text-summary"],
  "coverageDirectory": "tests/reports/coverage"
}
